# The llama.cpp build the acceptance tests run against. Keep LLAMA_COMMIT at the
# commit the deployment runs, so the tests prove the broker against that router.
LLAMA_REPOSITORY=https://github.com/ggml-org/llama.cpp.git
LLAMA_COMMIT=e6ab7c1a41054a888ada952eab4c886444c2f5ad

# The build environment, matching the deployment's image. 120 is the RTX 50 series.
CUDA_VERSION=12.8.1
UBUNTU_VERSION=24.04
GCC_VERSION=14
CUDA_DOCKER_ARCH=120
