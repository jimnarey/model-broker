# Private upstream llama.cpp router URL, reachable from the broker.
MODEL_BROKER_LLAMA_URL=http://llama-cpp:8080

# Read-only path to the unified llama.cpp preset, the same file the router uses.
MODEL_BROKER_PRESET_PATH=/config/models-preset.ini

# Seconds a model is protected from being unloaded after its last use, so an
# interactive user between turns keeps it.
MODEL_BROKER_IDLE_PROTECT_SECONDS=300

# Seconds a request waits for busy conflicting models before a 503 resource_busy.
# 0 refuses at once. Loading the model afterwards is not counted.
MODEL_BROKER_MAX_WAIT_SECONDS=30

# Seconds a load or unload may take before it counts as failed. The largest models
# can take minutes to load.
MODEL_BROKER_LOAD_TIMEOUT_SECONDS=600

# Optional: services that change model by restarting their container (Strata). Naming
# their preset adds their models to the catalogue. If a configured service cannot be
# reached (the service-control helper is down), the broker refuses all scheduling until it
# can, so leave this unset when none is in use.
# MODEL_BROKER_SERVICE_PRESET_PATH=/config/strata-models-preset.ini
# The host's service-control helper, which starts and stops the container. Mount its
# directory into the broker container, not the socket file.
# MODEL_BROKER_SERVICE_CONTROL_SOCKET=/run/model-broker-service-control/control.sock
# Seconds such a model may take to start; Strata's first start also builds its engine.
# MODEL_BROKER_SERVICE_LOAD_TIMEOUT_SECONDS=3600
# Strata's own API, which serves the model, and its key if it was started with one.
# MODEL_BROKER_STRATA_URL=http://strata:8080
# MODEL_BROKER_STRATA_API_KEY=

# DEBUG, INFO, WARNING or ERROR. DEBUG logs every admission, wait, observation,
# router call and request.
MODEL_BROKER_LOG_LEVEL=INFO

# Optional secrets file of API keys, one "client-name key" pair per line (keys of
# at least 16 characters, e.g. from `openssl rand -hex 24`). Unset turns
# authentication off: every request is accepted and startup logs a warning.
# MODEL_BROKER_API_KEYS_FILE=/run/secrets/model-broker-api-keys
