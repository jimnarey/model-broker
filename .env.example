# Private upstream llama.cpp router URL, reachable from the broker.
MODEL_BROKER_LLAMA_URL=http://llama-cpp:8080

# Read-only path to the unified llama.cpp preset, the same file the router uses.
MODEL_BROKER_PRESET_PATH=/config/models-preset.ini

# Seconds a model is protected from being unloaded after its last use, so an
# interactive user between turns keeps it.
MODEL_BROKER_IDLE_PROTECT_SECONDS=300

# Seconds a request waits for busy conflicting models before a 503 resource_busy.
# 0 refuses at once. Loading the model afterwards is not counted.
MODEL_BROKER_MAX_WAIT_SECONDS=30

# Optional secrets file of API keys, one "client-name key" pair per line (keys of
# at least 16 characters, e.g. from `openssl rand -hex 24`). Unset turns
# authentication off: every request is accepted and startup logs a warning.
# MODEL_BROKER_API_KEYS_FILE=/run/secrets/model-broker-api-keys
