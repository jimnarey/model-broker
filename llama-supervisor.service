[Unit]
Description=Capability-limited llama.cpp Compose supervisor
Documentation=file:///home/ai/server_containers/model-broker/README.md
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=llama-supervisor
Group=llama-supervisor
SupplementaryGroups=docker llama-supervisor-client
EnvironmentFile=/etc/llama-supervisor/environment
RuntimeDirectory=llama-supervisor
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/llama-supervisor/llama-supervisor.py --project ${LLAMA_SUPERVISOR_PROJECT} --socket ${LLAMA_SUPERVISOR_SOCKET} --secret ${LLAMA_SUPERVISOR_SECRET} --socket-group llama-supervisor-client
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ai/server_containers
ReadWritePaths=/var/lib/llama-supervisor
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
